# Copy to .env for local development. .env is ignored by git.
# Everything starting with EXPO_PUBLIC_ is baked into the app, so never put a secret here.

# The Fastermall API the app talks to (must be https://).
# EAS builds take this from eas.json instead (build profile "env").
EXPO_PUBLIC_API_URL=https://fastermall-super-app-backend.onrender.com/api/v1
